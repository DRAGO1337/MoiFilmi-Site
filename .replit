modules = ["web", "bash", "nodejs-24", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
MOIFILMI_ADMIN_EMAILS = "x86w@proton.me"

[objectStorage]
defaultBucketID = "replit-objstore-74fb427a-0434-4776-a9a1-037160eef211"
